# LangSmith — deploy, tracing, Context Hub.
LANGSMITH_API_KEY=

# Model access via the LangSmith LLM Gateway.
# The gateway's /openai/v1 path expects a BARE model id (gpt-5.5), while
# /v1 expects a namespaced one (openai/gpt-5.5). `mda dev` forces /openai/v1,
# so keep this path and the model in agent.ts in agreement.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gateway.smith.langchain.com/openai/v1

# Photon / Spectrum project credentials (dashboard → project).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Webhook signing. Use the LEGACY `signingSecret` from webhook registration,
# not the `whsec_` Standard Webhooks secret.
SPECTRUM_SIGNING_SECRET=
